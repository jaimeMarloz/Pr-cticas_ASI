# Laboratorio de redes (Práctica 4) - Administración de Sistemas Informáticos
# Una única máquina virtual Ubuntu con Docker + containerlab.
# Uso: vagrant up   (la primera vez tarda 10-15 minutos)

Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  config.vm.hostname = "asi-redes"

  config.vm.provider "virtualbox" do |vb|
    vb.name   = "asi-redes"
    vb.memory = 4096
    vb.cpus   = 2
  end

  # Carpeta del laboratorio visible dentro de la VM en /vagrant
  config.vm.synced_folder ".", "/vagrant"

  config.vm.provision "shell", path: "provision.sh"
end
